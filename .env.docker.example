# Keep DATABASE_URL in .env for host-based macOS development (localhost:5433).
# Docker containers use the PostgreSQL container name and its internal port.
DATABASE_URL_DOCKER=postgresql://USER:PASSWORD@postgres:5432/DATABASE

# Must match the HS256 issuer secret used to mint SitePilot upload JWTs.
SITEPILOT_JWT_SECRET=replace-with-the-existing-shared-secret-of-at-least-32-characters

SITEPILOT_API_PORT=3210
# Uploaded originals are retained indefinitely by default. Set a positive value only
# when an operator has explicitly chosen an automatic deletion lifecycle policy.
# SITEPILOT_DELETE_ORIGINALS_AFTER_HOURS=720

# Agent calls Gemini only when all three settings are explicitly configured.
# Put the key in this backend-only file; never use a VITE_ variable for it.
# SITEPILOT_LLM_PROVIDER=gemini
SITEPILOT_LLM_MODEL=gemini-3.5-flash-lite
SITEPILOT_LLM_TIMEOUT_MS=60000
SITEPILOT_EXTERNAL_LLM_DATA_ALLOWED=false
# GEMINI_API_KEY=
